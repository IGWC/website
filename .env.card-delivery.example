# Copy into the private server file ../data/card-delivery.env (chmod 600).
# These values are runtime-only. Never put them in the Docker build arguments.
IGWC_CARD_DELIVERY_ENABLED=false
IGWC_CARD_BACKEND_URL=
IGWC_CARD_WEBSITE_TOKEN=
# Last excluded ID: verify the migration boundary before enabling. No default.
IGWC_CARD_SYNC_AFTER_ID=
# Match the dashboard's current term before enabling; e.g. 2026-fall.
IGWC_CARD_TERM=
# Compose sets this directory; set it explicitly when running outside Docker.
IGWC_CARD_PROGRESS_DIR=/var/lib/igwc/card-delivery-v2

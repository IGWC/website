---
import '/src/styles/news.css';
import Layout from '/src/layouts/main.astro';

import { getCollection } from "astro:content";
const news = await getCollection('news');
news.sort((a, b) => b.data.date - a.data.date);

const options = {
  timeZone: "UTC",
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
};
---

<Layout frontmatter="">
<h1>News</h1>
<p>Want to stay in-the-loop with the IGWC at IU? Join our Mailing List!</p>
<p class="action"><a href="https://list.iu.edu/sympa/subscribe/igwc-ue-news-l">Join our Mailing List!</a></p>
<br>
  
  <div class="newsgrid">
  {news.map((story) => 
    <a href={'/news/' + story.id} class="story">
      <p class="title"><span class="underline">{story.data.title}</span></p>
      <p class="info">{story.data.date.toLocaleDateString("en-US", options)}</p>
    </a>
  )}
  </div>
</Layout>
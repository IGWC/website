---
import { getCollection, render } from 'astro:content';
import MarkdownPostLayout from '/src/layouts/main.astro';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map(story => ({
    params: { id: story.id },
    props: { story },
  }));
}
const options = {
  timeZone: "UTC",
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
};

const { story } = Astro.props;
const { Content } = await render(story);
---

<MarkdownPostLayout frontmatter={story.data}>
	<div class="border-solid border-b-[0.1rem] border-foreground">
		<h1 class="border-none">{story.data.title}</h1>
		<p class="font-mono text-sm m-1 uppercase flex"><span class="basis-16">URL:</span> <a href={"/news/" + story.id}>{story.id}</a></p>
		<p class="font-mono text-sm m-1 uppercase flex"><span class="basis-16">Date:</span> <span>{story.data.date.toLocaleDateString("en-US", options)}</span></p>
	</div>
	<div class="max-w-3xl my-8">
	<Content />
	</div>
</MarkdownPostLayout>
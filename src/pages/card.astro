---
import Layout from '/src/layouts/main.astro';
import { db, Departments } from 'astro:db';

import { Card } from '/src/layouts/components/card';

const depts = await db.select({
  value: Departments.deptCode, 
  label: Departments.deptName,
  subfieldLabel: Departments.subfieldLabel,
  subfieldHelpText: Departments.subfieldHelpText
}).from(Departments).orderBy(Departments.deptName);

---

<Layout frontmatter="">
  <h1>Sign a Union Card</h1>
  <Card client:load depts={depts}/>
</Layout>
